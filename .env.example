# .env.example — bc_sheet_processor
#
# PRODUÇÃO (Docker Swarm):
#   - REDIS_URL, N8N_WEBHOOK_USER e N8N_WEBHOOK_PASSWORD NÃO vêm do .env —
#     são criados como Docker secrets (`docker secret create`) e lidos pelo
#     entrypoint.sh em /run/secrets/.
#   - N8N_WEBHOOK_URL, WORKERS e TAG são interpolados do .env pelo
#     `docker stack deploy` (diretiva `env_file:` não funciona em Swarm).
#
# DESENVOLVIMENTO LOCAL (docker compose up):
#   - Todas as variáveis abaixo são lidas normalmente do .env.

USERNAME=bcsheetprocessor
WORKERS=2
REDIS_URL=change_here
N8N_WEBHOOK_URL=change_here
N8N_WEBHOOK_USER=change_here
N8N_WEBHOOK_PASSWORD=change_here
# Tag da imagem GHCR — deploy.sh/rebuild.sh calculam automaticamente
# <branch>-<sha> após o git pull. Só use override se quiser fixar uma tag.
#TAG=latest
